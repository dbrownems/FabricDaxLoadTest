<Batch xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
  <Create>
    <ObjectDefinition>
      <Trace>
        <ID>FabricDaxLoadTest_TraceTemplate</ID>
        <Name>FabricDaxLoadTest_TraceTemplate</Name>
        <!--
          Server-side trace definition for FabricDaxLoadTest.

          The <ID> and <Name> nodes above are placeholders rewritten at
          runtime by TraceSubscriber.LoadCreateTemplate to a per-run
          FDLT-<random id>.

          Event/column matrix curated from PbiLoadTester's
          LiveTraceCapture.EventColumns dictionary, which has been tested
          against the live PBI Service and Fabric XMLA endpoints. Rules
          (details and history in docs/tracing.md):

          1. ColumnID 0 (EventClass) is included on EVERY event. ADOMD's
             Subscribe reader returns rows with the union of all
             requested columns; without EventClass we cannot map a row
             back to its event class and the row is dropped. PBI's own
             Profiler-export trace definitions OMIT EventClass per
             event — copying those breaks the row dispatcher.
          2. Never include ColumnID 44 (RequestParameters) or 45
             (RequestProperties) on any event. PBI Service emits these
             as list-shaped BinaryXml that the ADOMD reader rejects
             mid-stream with "Lists of BinaryXml value tokens not
             supported." — kills the whole subscription.
          3. Keep the event set small. Under heavy load the server-side
             trace buffer can overflow, after which AS silently stops
             emitting events for the rest of the run.

          NO <Filter> clause: PBI Service rejects server-side filters on
          subscription traces. TraceSubscriber.ProcessRow filters
          client-side on ApplicationName=FabricDaxLoadTest/<RunId>.
        -->
        <Events>

          <!-- 15: CommandBegin — XMLA command start -->
          <Event>
            <EventID>15</EventID>
            <Columns>
              <ColumnID>0</ColumnID>
              <ColumnID>1</ColumnID>
              <ColumnID>2</ColumnID>
              <ColumnID>3</ColumnID>
              <ColumnID>25</ColumnID>
              <ColumnID>28</ColumnID>
              <ColumnID>32</ColumnID>
              <ColumnID>33</ColumnID>
              <ColumnID>36</ColumnID>
              <ColumnID>37</ColumnID>
              <ColumnID>39</ColumnID>
              <ColumnID>41</ColumnID>
              <ColumnID>42</ColumnID>
              <ColumnID>47</ColumnID>
            </Columns>
          </Event>

          <!-- 16: CommandEnd — XMLA command end -->
          <Event>
            <EventID>16</EventID>
            <Columns>
              <ColumnID>0</ColumnID>
              <ColumnID>1</ColumnID>
              <ColumnID>2</ColumnID>
              <ColumnID>3</ColumnID>
              <ColumnID>5</ColumnID>
              <ColumnID>6</ColumnID>
              <ColumnID>24</ColumnID>
              <ColumnID>25</ColumnID>
              <ColumnID>28</ColumnID>
              <ColumnID>32</ColumnID>
              <ColumnID>33</ColumnID>
              <ColumnID>36</ColumnID>
              <ColumnID>37</ColumnID>
              <ColumnID>39</ColumnID>
              <ColumnID>41</ColumnID>
              <ColumnID>42</ColumnID>
              <ColumnID>47</ColumnID>
            </Columns>
          </Event>

          <!-- 17: Error -->
          <Event>
            <EventID>17</EventID>
            <Columns>
              <ColumnID>0</ColumnID>
              <ColumnID>3</ColumnID>
              <ColumnID>24</ColumnID>
              <ColumnID>25</ColumnID>
              <ColumnID>28</ColumnID>
              <ColumnID>32</ColumnID>
              <ColumnID>33</ColumnID>
              <ColumnID>36</ColumnID>
              <ColumnID>37</ColumnID>
              <ColumnID>41</ColumnID>
              <ColumnID>42</ColumnID>
            </Columns>
          </Event>

          <!-- Events 9/10 (QueryBegin/End), 82/83/85 (VertiPaq SE
               query events), 112 (DAXQueryPlan) and 134 (JobGraph) are
               intentionally NOT captured: they multiplied per-query
               trace volume and overflowed the server-side trace buffer
               under load. ExecutionMetrics (136) supplies engine
               duration and CPU instead. See docs/tracing.md. -->

          <!-- 98: DirectQueryBegin -->
          <Event>
            <EventID>98</EventID>
            <Columns>
              <ColumnID>0</ColumnID>
              <ColumnID>2</ColumnID>
              <ColumnID>3</ColumnID>
              <ColumnID>5</ColumnID>
              <ColumnID>6</ColumnID>
              <ColumnID>10</ColumnID>
              <ColumnID>13</ColumnID>
              <ColumnID>24</ColumnID>
              <ColumnID>25</ColumnID>
              <ColumnID>28</ColumnID>
              <ColumnID>32</ColumnID>
              <ColumnID>33</ColumnID>
              <ColumnID>36</ColumnID>
              <ColumnID>37</ColumnID>
              <ColumnID>39</ColumnID>
              <ColumnID>41</ColumnID>
              <ColumnID>42</ColumnID>
              <ColumnID>47</ColumnID>
            </Columns>
          </Event>

          <!-- 99: DirectQueryEnd -->
          <Event>
            <EventID>99</EventID>
            <Columns>
              <ColumnID>0</ColumnID>
              <ColumnID>2</ColumnID>
              <ColumnID>3</ColumnID>
              <ColumnID>5</ColumnID>
              <ColumnID>6</ColumnID>
              <ColumnID>10</ColumnID>
              <ColumnID>13</ColumnID>
              <ColumnID>24</ColumnID>
              <ColumnID>25</ColumnID>
              <ColumnID>28</ColumnID>
              <ColumnID>32</ColumnID>
              <ColumnID>33</ColumnID>
              <ColumnID>36</ColumnID>
              <ColumnID>37</ColumnID>
              <ColumnID>39</ColumnID>
              <ColumnID>41</ColumnID>
              <ColumnID>42</ColumnID>
              <ColumnID>47</ColumnID>
            </Columns>
          </Event>

          <!-- 136: ExecutionMetrics — JSON CPU/memory/throttling metrics,
               one per query. persist.py reads engine duration
               (durationMs) and CPU (totalCpuTimeMs) from its JSON;
               analyze.py reads the CPU. ColumnID 46 (ActivityID) links
               it back to the client-side execution (QuerySeq). NOTE:
               SessionID (ColumnID 39) is NOT populated by AS on event
               136 — only session-scoped events (Command*, Audit*)
               carry it. -->
          <Event>
            <EventID>136</EventID>
            <Columns>
              <ColumnID>0</ColumnID>
              <ColumnID>2</ColumnID>
              <ColumnID>28</ColumnID>
              <ColumnID>37</ColumnID>
              <ColumnID>41</ColumnID>
              <ColumnID>42</ColumnID>
              <ColumnID>46</ColumnID>  <!-- ActivityID — links to QuerySeq -->
              <ColumnID>47</ColumnID>
            </Columns>
          </Event>

        </Events>
      </Trace>
    </ObjectDefinition>
  </Create>
</Batch>
